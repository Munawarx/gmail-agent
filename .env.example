# --- Auth mode ---
# oauth (default): needs Google Cloud project + credentials.json (see README)
# imap          : NO Google Cloud project. Uses an App Password instead.
GMAIL_MODE=imap

# --- IMAP mode (no OAuth) ---
# 1. Enable 2-Step Verification on your Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below (no spaces).
GMAIL_USER_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxcccc
GMAIL_IMAP_HOST=imap.gmail.com

# --- OAuth mode (alternative; GMAIL_MODE=oauth) ---
# GMAIL_TOKEN_JSON=token.json
# GMAIL_CREDENTIALS_JSON=credentials.json

# ---------------------------------------------------------------------------
# LLM escalation tier (the "AI" in the Gmail AI Agent)
# Default model is HY3 (tencent/hy3 via OpenRouter). If HY3 is unavailable the
# agent automatically falls back to LLM_FALLBACK_MODEL. The deterministic rule
# engine runs first; the LLM is consulted ONLY for borderline "keep" emails.
# ---------------------------------------------------------------------------
# Set true to enable the HY3 LLM classification tier.
USE_LLM=true

# Primary model = HY3. (tencent/hy3 is the live HY3 slug on OpenRouter.)
LLM_MODEL=tencent/hy3

# Automatic fallback if HY3 is unavailable. Keeps the agent running offline-capable.
LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free

# OpenRouter endpoint (OpenAI-compatible). Leave as-is.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Per-request timeout (seconds).
LLM_TIMEOUT=25

# API key. If you leave this blank, the agent reuses the OPENROUTER_API_KEY
# stored in the Hermes gateway .env (%LOCALAPPDATA%/hermes/.env),
# so you only manage one key.
LLM_API_KEY=

# (Legacy) kept for compatibility; not used by the HY3 tier.
OPENAI_API_KEY=

DB_PATH=state/gmail_agent.db
LOG_DIR=logs
DRY_RUN=false
MAX_EMAILS=0
